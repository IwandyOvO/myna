{
  "expo": {
    "name": "Myna",
    "slug": "myna",
    "scheme": "myna",
    "version": "0.8.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.myna.ios",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Myna uses your location to tag where a post is from and to show posts near you. You can always pick a city instead."
      }
    },
    "android": {
      "package": "app.myna.android",
      "adaptiveIcon": {
        "backgroundColor": "#F3F0EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Myna uses your location to tag where a post is from and to show posts near you. You can always pick a city instead."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Myna lets you add photos to a post. Location data embedded in photos is removed before upload.",
          "cameraPermission": "Myna uses the camera so you can photograph what you are asking about.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F6F5F2",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#16171B"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF5A3C"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "iwandy",
    "extra": {
      "eas": {
        "projectId": "ba2ad804-202b-43f7-b3ad-712f9faf5891"
      }
    }
  }
}
