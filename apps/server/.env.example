DATABASE_URL=postgres://myna:myna@localhost:5432/myna
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
# Dev only: lets the app log in as a seeded user and returns e-mail codes in the API response.
ALLOW_DEV_LOGIN=1
DEV_EXPOSE_EMAIL_CODES=1
# Social sign-in (leave empty to disable that provider; the endpoint then answers 501)
GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Operating parameters (§14) — tune without code changes
BOARD_MIN_RATINGS=50

# §4.4 blind window in hours (keep in sync with the app copy)
BLIND_HOURS=24
# Where uploaded images are stored in development
# UPLOAD_DIR=./uploads
