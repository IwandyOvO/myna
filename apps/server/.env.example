DATABASE_URL=postgres://myna:myna@localhost:5432/myna
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
# Dev only: lets the app log in as a seeded user and returns e-mail codes in the API response.
ALLOW_DEV_LOGIN=1
DEV_EXPOSE_EMAIL_CODES=1
# Social sign-in (leave empty to disable that provider; the endpoint then answers 501)
GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Operating parameters (§14) — tune without code changes
BOARD_MIN_RATINGS=50

# §4.4 blind window in hours (keep in sync with the app copy)
BLIND_HOURS=24
# Where uploaded images are stored in development
# UPLOAD_DIR=./uploads
# --- production ---
# Browser origins allowed by CORS (comma-separated). Native apps don't need this.
CORS_ORIGINS=
# Set to 1 behind a load balancer / reverse proxy so rate limits see real client IPs.
TRUST_PROXY=0
# Requests per minute per IP
RATE_LIMIT_GENERAL=300
RATE_LIMIT_AUTH=10
RATE_LIMIT_UPLOAD=30
DB_POOL_MAX=10
# Expo push: optional access token if "enhanced push security" is enabled for the project
EXPO_ACCESS_TOKEN=
LOG_LEVEL=info
