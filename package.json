{
  "name": "myna",
  "version": "0.8.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node tools/dev.mjs",
    "test": "npm run test -w @myna/shared && npm run test -w @myna/server",
    "typecheck": "npm run typecheck -w @myna/shared && npm run typecheck -w @myna/server && npm run typecheck -w @myna/mobile",
    "db:migrate": "npm run db:migrate -w @myna/server",
    "db:seed": "npm run db:seed -w @myna/server",
    "server": "npm run dev -w @myna/server",
    "mobile": "npm run start -w @myna/mobile",
    "admin:grant": "npm run admin:grant -w @myna/server --"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
